+  };
+}
+
+export interface DashboardData {
+  event: EventDetail;
+  bookings: AttendeeBooking[];
+}
+
+// รอบเวลาในฟอร์มสร้างกิจกรรม
+export interface SessionInput {
+  startTime: string;
+  endTime: string;
