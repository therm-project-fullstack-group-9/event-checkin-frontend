+// ข้อมูลกิจกรรมแบบสรุป (หน้า Explore)
+export interface EventSummary {
+  eventId: string;
+  eventName: string;
+  shortDescription: string;
+  eventDate: string;
+  venue: string;
+  category: string;
+  imageUrl: string;
+  eventsStatus: string;
+  maxCapacity: number;
+}
+
+// ข้อมูลกิจกรรมเต็ม (หน้ารายละเอียด)
